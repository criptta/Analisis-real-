#| label: fig-test
#| warning: false
#| message: false
library(ggplot2)
df <- data.frame(n = 0:10, S_n = cumsum(0.5^(0:10)))
ggplot(df, aes(x = n, y = S_n)) +
geom_line(color = "blue", linewidth = 1) +
geom_point(color = "red") +
theme_minimal()
install.packages("latex2exp")
