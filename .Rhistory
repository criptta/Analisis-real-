#| label: fig-geometrica
#| fig-cap: "Convergencia de la serie geométrica (r = 0.5)"
#| warning: false
library(ggplot2)
n_vals <- 0:10
a <- 1
r <- 0.5
sumas_parciales <- cumsum(a * r^n_vals)
df <- data.frame(n = n_vals, S_n = sumas_parciales)
ggplot(df, aes(x = n, y = S_n)) +
geom_line(color = "#00BFFF", linewidth = 1) +
geom_point(color = "red", size = 2) +
geom_hline(yintercept = 2, linetype = "dashed", color = "gray") +
annotate("text", x = 2, y = 2.2, label = "Límite S = 2") +
labs(title = "Suma Parcial: Serie Geométrica",
x = "Término (n)", y = "Suma acumulada (Sn)") +
theme_minimal()
